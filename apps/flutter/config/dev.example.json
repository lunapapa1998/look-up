{
  "_comment": "Copy to config/dev.json and fill in. config/dev.json is gitignored. See AUTH_SETUP.md. Firebase values come from GoogleService-Info.plist / google-services.json (generated by `flutterfire configure`).",
  "AUTH_ENABLED": true,
  "FIREBASE_API_KEY": "<firebase api key>",
  "FIREBASE_APP_ID": "<platform firebase app id, e.g. 1:NNN:ios:xxxx>",
  "FIREBASE_MESSAGING_SENDER_ID": "<sender id>",
  "FIREBASE_PROJECT_ID": "<project id>",
  "FIREBASE_IOS_BUNDLE_ID": "com.feel.lookup",
  "GOOGLE_CLIENT_ID": "<ios oauth client id>.apps.googleusercontent.com",
  "GOOGLE_SERVER_CLIENT_ID": "<web oauth client id>.apps.googleusercontent.com",
  "GOOGLE_LOGIN_ENABLED": true,
  "APPLE_LOGIN_ENABLED": false,
  "KAKAO_LOGIN_ENABLED": true,
  "KAKAO_NATIVE_APP_KEY": "<kakao native app key>",
  "API_BASE_URL": "http://localhost:8000"
}
