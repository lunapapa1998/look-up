# This file documents the REPO-ROOT .env (two directories up from apps/backend,
# i.e. lookup/.env) that app/suitability/config.py loads via python-dotenv.
# It is NOT apps/backend's own .env -- copy these vars into the repo-root .env.

# Weather provider selection (environment layer). Only "kma" is supported.
WEATHER_PROVIDER=kma

# KMA API Hub (기상청 API 허브) base URL.
KMA_APIHUB_BASE_URL=https://apihub.kma.go.kr/api/typ01/cgi-bin/url

# KMA API Hub key.
KMA_APIHUB_KEY=your_key_here

# KASI sunrise/sunset (riseset) service base URL.
KASI_RISESET_BASE_URL=your_kasi_riseset_base_url_here

# KASI lunar phase (lunph) service base URL.
KASI_LUNPH_BASE_URL=your_kasi_lunph_base_url_here

# data.go.kr service key shared by the KASI riseset/lunph endpoints.
# Encoding 형식 키. 코드가 자동으로 urllib.parse.unquote 처리함.
DATA_GO_KR_SERVICE_KEY=your_encoded_service_key_here

# 있으면 위 DATA_GO_KR_SERVICE_KEY(Encoding)보다 우선 사용됨.
# 인코딩 이슈를 우회하려면 이 값을 직접 채워도 됨.
DATA_GO_KR_SERVICE_KEY_DECODED=your_decoded_service_key_here

# TIDE (KHOA 조석예보 고저조) API base URL. 새 키 불필요 -- 위
# DATA_GO_KR_SERVICE_KEY(또는 DECODED)를 그대로 재사용함.
# 선택 항목 -- 기본값이 이미 코드(app/suitability/config.py)에 있음.
TIDE_API_BASE_URL=https://apis.data.go.kr/1192136/tideFcstHghLw/GetTideFcstHghLwApiService

# 두루누비(Durunubi, 걷기여행길) 코스 API base URL. 새 키 불필요 -- 위
# DATA_GO_KR_SERVICE_KEY(또는 DECODED)를 그대로 재사용함.
# 선택 항목 -- 기본값이 이미 코드(app/suitability/config.py)에 있음.
DURUNUBI_BASE_URL=https://apis.data.go.kr/B551011/Durunubi

# TourAPI(한국관광공사, 주변 음식점) base URL. 새 키 불필요 -- 위
# DATA_GO_KR_SERVICE_KEY(또는 DECODED)를 그대로 재사용함.
# 선택 항목 -- 기본값이 이미 코드(app/suitability/config.py)에 있음.
TOURAPI_BASE_URL=https://apis.data.go.kr/B551011/KorService2
